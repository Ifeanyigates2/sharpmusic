# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/sharpmusic?appName=sharpmusic

# Signs admin session cookies
SESSION_SECRET=replace-with-long-random-string

# Admin seed / login (quote passwords that contain #)
ADMIN_EMAIL=admin@sharpmusic.com
ADMIN_PASSWORD="change-me"
ADMIN_NAME=Admin

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Music News — social APIs (optional; needed to auto-pull posts)
# X / Twitter API v2 bearer token (read access)
TWITTER_BEARER_TOKEN=
# Meta Graph API long-lived token (Instagram / Facebook / Threads)
META_ACCESS_TOKEN=
# Instagram Business account id used for business_discovery lookups
META_IG_BUSINESS_ID=
# Threads (account-scoped; only syncs the linked Threads user)
META_THREADS_USER_ID=
META_THREADS_USERNAME=
# Protects /api/news/sync for Vercel Cron (also accepts Vercel CRON_SECRET)
NEWS_CRON_SECRET=replace-with-long-random-string

# Gemini — picks the next song when a track ends / skip is pressed
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Email listeners when their song request is marked added (Resend)
# https://resend.com — From must be a verified Resend/domain address
RESEND_API_KEY=
# Display name can include your title; mailbox must be allowed by Resend
EMAIL_FROM="Ifeanyi, CEO of Sharp Music <onboarding@resend.dev>"
EMAIL_REPLY_TO=Ifeanyiapple1@gmail.com
EMAIL_SIGN_NAME="Ifeanyi, CEO of Sharp Music"
# Optional public site URL used in email links
# APP_URL=https://sharpmusic.com
